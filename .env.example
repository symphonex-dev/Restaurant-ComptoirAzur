# ==============================================================================
# Configuration EmailJS — formulaire de réservation
# ==============================================================================
# Copiez ce fichier en ".env" (sans ".example") à la racine du projet, puis
# remplissez les trois valeurs ci-dessous. Voir le README, section
# "Configurer EmailJS", pour la marche à suivre détaillée.
#
# IMPORTANT : le fichier ".env" ne doit JAMAIS être commité (il est déjà
# exclu via .gitignore). Ces identifiants sont des clés publiques prévues
# pour être exposées côté client par EmailJS, mais autant garder l'habitude
# de ne pas les committer.
# ==============================================================================

VITE_EMAILJS_SERVICE_ID=votre_service_id
VITE_EMAILJS_TEMPLATE_ID=votre_template_id
VITE_EMAILJS_PUBLIC_KEY=votre_public_key
